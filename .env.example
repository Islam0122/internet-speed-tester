# Number of sequential requests performed when requests_count is not provided.
DEFAULT_REQUESTS_COUNT=10

# Hard upper bound the API will accept for requests_count.
MAX_REQUESTS_COUNT=50

# Connection and read timeouts, in seconds.
CONNECT_TIMEOUT_SECONDS=5.0
READ_TIMEOUT_SECONDS=15.0

# Maximum number of bytes read from a single response before aborting it.
MAX_RESPONSE_BYTES=209715200

# Maximum number of HTTP redirects HTTPX will follow per request.
MAX_REDIRECTS=5

# Chunk size (bytes) used while streaming response bodies.
CHUNK_SIZE_BYTES=65536

# Whether to reject URLs that resolve to private/loopback/link-local/metadata
# IP addresses (basic SSRF protection). Set to false only for local testing
# against e.g. http://localhost resources.
ENABLE_SSRF_PROTECTION=true

# Host/port uvicorn binds to (used by the Docker image's CMD).
APP_HOST=0.0.0.0
APP_PORT=8000
